# Turbohaul-Manager cuda-multi — broad-architecture variant.
# Compiles the vendored TurboQuant llama-server FROM SOURCE with CUDA arches covering
# Turing through Blackwell (sm_75 / sm_80 / sm_86 / sm_89 / sm_90 / sm_120).
# One image, works on ~99% of CUDA-capable consumer/prosumer NVIDIA cards
# 2018+ (GTX 16-series and later).
#
# Build time: ~30-40 min (NVCC compile for 6 architectures).
# Image size: slightly larger than a single-arch build (extra compiled kernels).
#
# Build:
#   docker build -f Dockerfile.cuda-multi -t turbohaul-manager:v0.6.0 .

# ----------------------------------------------------------------------------
# Stage 1: Frontend (same as the slim Dockerfile)
# ----------------------------------------------------------------------------
FROM node:20-alpine AS frontend-build
WORKDIR /work
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/frontend/. ./
RUN npm run typecheck && npm run build

# ---------------------------------------------------------------------------
# Stage 2: Compile the vendored TurboQuant engine from source for 6 GPU arches.
# CUDA_ARCHITECTURES is expanded to cover Turing through Blackwell.
# CUDA builds are Linux/amd64 + NVIDIA GPU ONLY -- on macOS / Apple Silicon /
# non-amd64 hosts this cannot run (no NVIDIA Container Toolkit) and building it
# would pull the ~8GB nvidia/cuda base for nothing. The --platform pin makes an
# accidental build on the wrong arch fail fast instead of downloading CUDA.
# ---------------------------------------------------------------------------
FROM --platform=linux/amd64 nvidia/cuda:12.9.0-devel-ubuntu22.04 AS llama-binary

ARG DEBIAN_FRONTEND=noninteractive
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git cmake build-essential ca-certificates curl pkg-config \
      libcurl4-openssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Engine source VENDORED in-repo (self-contained -- no external git clone).
COPY engine/llama-cpp-turboquant /opt/turboquant
RUN echo vendored-engine-86771a58d > /opt/build_commit.txt

WORKDIR /opt/turboquant

# CUDA stubs symlink dance — needed so cmake's link step against libcuda.so
# can succeed at build time (real libcuda.so.1 is injected by host driver
# at runtime via NVIDIA Container Toolkit).
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 \
 && ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/lib/x86_64-linux-gnu/libcuda.so.1 \
 && ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/lib/x86_64-linux-gnu/libcuda.so \
 && ldconfig \
 && cmake -B build \
      -DGGML_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES="75;80;86;89;90;120" \
      -DGGML_CUDA_FA=ON \
      -DGGML_CUDA_FA_ALL_QUANTS=ON \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs \
      -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
      -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
      -DLLAMA_USE_PREBUILT_UI=OFF \
 && cmake --build build --config Release -j$(nproc) \
      --target llama-server \
 && strip /opt/turboquant/build/bin/llama-server || true

# ---------------------------------------------------------------------------
# Stage 3: Runtime (CUDA 12.9 runtime + Python 3.11 + Turbohaul)
# CUDA builds are Linux/amd64 + NVIDIA GPU ONLY -- see Stage 2 note.
# ---------------------------------------------------------------------------
FROM --platform=linux/amd64 nvidia/cuda:12.9.0-runtime-ubuntu22.04 AS runtime

# ffmpeg/ffprobe are deliberately NOT apt-installed here (video
# decoding is served by an external plugin container through the manager's
# plugin routing, not local media tooling). Still images (stb_image) and audio
# (miniaudio) are compiled into the engine and never needed ffmpeg. The
# ffmpeg/ffprobe PATH entries the engine forks (mtmd-helper.cpp:921-924) are
# provided below by the PATH shim, not by apt.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-dev \
      ca-certificates curl procps libgomp1 \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python

# venv on python3.11 -> modern pip, clean isolation from system py3.10.
RUN python3.11 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip
ENV PATH=/opt/venv/bin:${PATH}

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/turbohaul/ ./src/turbohaul/
RUN /opt/venv/bin/pip install --no-cache-dir .
RUN /opt/venv/bin/pip install --no-cache-dir jsonschema==4.21.1

# Copy the compiled llama-server + its .so libs from stage 2.
# Preserve /opt/turboquant/build/bin so the hardcoded RPATH resolves.
COPY --from=llama-binary /opt/turboquant/build/bin /opt/turboquant/build/bin
COPY --from=llama-binary /opt/build_commit.txt /opt/build_commit.txt

# Build-time guard: fail HERE if this layer left a mixed/partial engine (e.g. a
# fresh libllama-server-impl.so over a stale libllama.so missing a symbol it needs) --
# not at the first production KV save. binutils is TRANSIENT: installed, used, purged,
# apt lists cleaned, all in this one RUN layer, so the runtime image never ships it.
COPY scripts/check_engine_symbols.sh /tmp/check_engine_symbols.sh
# Second guard: the KV-variant check. It inspects the engine library that this
# file actually COMPILES FROM SOURCE (not a pre-built library blob),
# so it watches the engine that is rebuilt on every image build,
# i.e. what we really ship.
# It rides the SAME transient binutils install as the symbols check above,
# because it needs `strings` too: no extra layer, no extra image weight.
# Enforcing by default (ENFORCE_DEFAULT=1). Set CHECK_ENGINE_KV_VARIANT_ENFORCE=0 to
# downgrade a failure to a loud warning for a one-off build.
COPY scripts/check_engine_kv_variant.sh /tmp/check_engine_kv_variant.sh
RUN apt-get update \
 && apt-get install -y --no-install-recommends binutils \
 && bash /tmp/check_engine_symbols.sh /opt/turboquant/build/bin \
 && bash /tmp/check_engine_kv_variant.sh --require-present /opt/turboquant/build/bin/libllama.so.0.0.0 \
 && apt-get purge -y --auto-remove binutils \
 && rm -rf /var/lib/apt/lists/* /tmp/check_engine_symbols.sh /tmp/check_engine_kv_variant.sh

RUN mkdir -p /opt/turbohaul/bin \
 && ln -sf /opt/turboquant/build/bin/llama-server /opt/turbohaul/bin/llama-server

# Frontend bundle.
COPY --from=frontend-build /work/dist /opt/turbohaul/ui_dist

# The generic PATH shim, installed under each executable name it
# serves (mirrors the root Dockerfile -- that file is not what this
# image builds from, so the same shim is installed here). The engine resolves
# `ffmpeg`/`ffprobe` from PATH exactly as if the binary were baked in; the
# shim is LOCAL-FIRST (a real local binary execv's with zero hops, so an
# operator-baked ffmpeg keeps working untouched) and otherwise routes the
# call through the forwarder to the plugin container's /ws/exec endpoint. The
# executable name IS the binary parameter (argv[0] of the
# symlink); optional per-install semantics live in /etc/ffshim/<name>.env.
# One COPY + symlinks (no per-name copies to drift).
COPY engine/ffshim/ffshim.py /opt/turbohaul/shim/ffshim.py
RUN chmod 755 /opt/turbohaul/shim/ffshim.py \
 && mkdir -p /etc/ffshim \
 && for name in ffmpeg ffprobe; do ln -sf /opt/turbohaul/shim/ffshim.py /usr/local/bin/$name; done

# Runtime dirs.
RUN mkdir -p /var/lib/turbohaul /etc/turbohaul \
 && chmod 700 /var/lib/turbohaul

COPY docker/turbohaul.default.yaml /etc/turbohaul/turbohaul.yaml
COPY THIRD_PARTY_LICENSES.md /usr/share/doc/turbohaul/THIRD_PARTY_LICENSES.md

EXPOSE 11401

ENV TURBOHAUL_CONFIG_PATH=/etc/turbohaul/turbohaul.yaml \
    TURBOHAUL_ALLOW_PUBLIC_BIND=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/lib64/stubs

HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD curl -fsS http://127.0.0.1:11401/health || exit 1

ENTRYPOINT ["turbohaul-manager"]
